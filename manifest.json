{
  "manifest_version": 3,
  "name": "GameBoy Plugin by Tonkatsudon",
  "short_name": "GameBoy Plugin",
  "version": "0.1.0",
  "description": "A tiny Game Boy that floats over every page you visit and plays real Game Boy games. Made by Tonkatsudon.",
  "author": {
    "email": "tonkatsudon@tonkatsudon.com"
  },
  "homepage_url": "https://github.com/tonkatsudon-vibe/gameboy-chrome-extension",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/overlay.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/frame-reporter.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "GameBoy Plugin by Tonkatsudon",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup.html",
        "src/emulator.html",
        "src/emulator.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "sandbox": {
    "pages": [
      "src/emulator.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob:; object-src 'none'"
  }
}
